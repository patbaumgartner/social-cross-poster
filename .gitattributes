##############################################################################
# .gitattributes — normalise line endings across platforms
##############################################################################

# ── Default: normalise all text files to LF ──────────────────────────────────
* text=auto eol=lf

# ── Documentation & config ───────────────────────────────────────────────────
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.py          text eol=lf
*.sh          text eol=lf
*.cmd         text eol=crlf

# ── Binary files — no line-ending conversion ─────────────────────────────────
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.jar         binary
