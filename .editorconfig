# EditorConfig — consistent whitespace across editors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown keeps two trailing spaces as a hard line break
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_size = 2
