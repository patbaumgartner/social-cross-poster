# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
#
# Owner login (ADR-005) — fail-closed, no defaults:
#   APP_USER: the single owner username.
#   APP_PASSWORD_HASH: an adaptive hash of the password, e.g. a {bcrypt} hash
#     generated with `htpasswd -bnBC 10 "" "your-password" | cut -d: -f2`
#     (prefix with {bcrypt}). Plain text is never accepted.
APP_USER=change-me
APP_PASSWORD_HASH={bcrypt}REPLACE_WITH_ADAPTIVE_HASH

# Public origin of this installation, used for provider OAuth callbacks (ADR-008).
APP_BASE_URL=http://localhost:8080

# Database sidecar credentials (ADR-009). The db service is private; these only
# configure the app's JDBC connection.
DB_NAME=socialcrossposter
DB_USER=socialcrossposter
DB_PASSWORD=change-me-too

# Image tag to deploy; defaults to the latest published image in docker-compose.yml.
# SCP_IMAGE=ghcr.io/patbaumgartner/social-cross-poster:latest
